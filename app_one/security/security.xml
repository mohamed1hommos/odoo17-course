    <record id="base.menu_administration" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]" />
    </record>
    <record id="rule_stock_warehouse_user_access" model="ir.rule">
        <field name="name">Warehouse Access</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="domain_force">
            [('id', 'in', user.warehouse_ids_custom.ids)]
        </field>
        <field name="groups" eval="[(4, ref('app_one.test_user_group'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_stock_location_user_access" model="ir.rule">
        <field name="name">Location Access</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="domain_force">
            [('warehouse_id', 'in', user.warehouse_ids_custom.ids)]
        </field>
        <field name="groups" eval="[(4, ref('app_one.test_user_group'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_stock_picking_user_access" model="ir.rule">
        <field name="name">Picking Access</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">
            [('picking_type_id.warehouse_id', 'in', user.warehouse_ids_custom.ids)]
        </field>
        <field name="groups" eval="[(4, ref('app_one.test_user_group'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>

    </record>
    <record id="rule_stock_move_user_access" model="ir.rule">
        <field name="name">Move Access</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="domain_force">
            [('picking_type_id.warehouse_id', 'in', user.warehouse_ids_custom.ids)]
        </field>
        <field name="groups" eval="[(4, ref('app_one.test_user_group'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_stock_picking_type_user_access" model="ir.rule">
        <field name="name">Operation Types Access</field>
        <field name="model_id" ref="stock.model_stock_picking_type"/>
        <field name="domain_force">
            ['|', ('warehouse_id', 'in', user.warehouse_ids_custom.ids), ('warehouse_id', '=', False)]
        </field>
        <field name="groups" eval="[(4, ref('app_one.test_user_group'))]"/>
        <field name="perm_read" eval="True"/> <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="group_customer_restriction" model="res.groups">
        <field name="name">Restricted Customer Access</field>
    </record>
    <record id="partner_customer_rule" model="ir.rule">
        <field name="name">Customer Restriction</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('app_one.group_sales_global_user'))]"/>
        <field name="domain_force">[('category_id', 'in', user.allow_partner_tag_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
