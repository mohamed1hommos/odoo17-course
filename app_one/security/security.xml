        <field name="name">HR category</field>
    </record>
    <record model="res.groups" id="hr_group_general">
        <field name="category_id" ref="module_category_human_resources_employees_custom"/>
        <field name="name">HR group apps</field>
    </record>

    <record id="purchasing_rule_see_their_only_record" model="ir.rule">
        <field name="name">See their only record (Global)</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('user_id', '!=', False), ('user_id', '=', user.id)]</field>
<!--        <field name="groups" eval="[(4, ref('app_one.purchase_user_group'))]"/>-->
        <field name="global" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="property_real_thier_own_record" model="ir.rule">
        <field name="name">read property</field>
        <field name="model_id" ref="app_one.model_property"/>
        <field name="domain_force">[('creator_id', '!=', False), ('creator_id', '=', user.id)]</field>
<!--        <field name="groups" eval="[(4, ref('app_one.purchase_user_group'))]"/>-->
