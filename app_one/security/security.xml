<!--            <field name="name">Custom User Preference</field>-->
<!--        </record>-->

        <record id="group_inventory_custom_manager" model="res.groups">
            <field name="name">Custom Manager</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="implied_ids" eval="[(4, ref('group_inventory_custom_user'))]"/>
        </record>

        <!-- ==================== Real Estate Groups ==================== -->
        <record id="property_group" model="ir.module.category">
            <field name="name">Real Estate</field>
        </record>
        <record id="property_user_group" model="res.groups">
            <field name="name">Property User</field>
            <field name="category_id" ref="app_one.property_group"/>
        </record>
        <!-- ==================== Inventory Groups ==================== -->

        <record id="test_property" model="ir.module.category">
            <field name="name">Test Property</field>
        </record>
        <record id="test_user_group" model="res.groups">
            <field name="name">TEST GROUP</field>
            <field name="category_id" ref="app_one.test_property"/>
        </record>

        <!-- ==================== Warehouse Company Groups ==================== -->
        <record id="warehouse_company_user_group" model="res.groups">
            <field name="name">Warehouse Company User</field>
            <field name="category_id" ref="app_one.warehouse_company"/>
        </record>

        <!-- ==================== Purchase Groups ==================== -->
        <record id="purchase_user_group" model="res.groups">
            <field name="name">Purchase User</field>
            <field name="category_id" ref="app_one.purchase_group"/>
        </record>

        <record id="purchase_admin_group" model="res.groups">
            <field name="name">Purchase Admin</field>
            <field name="category_id" ref="app_one.purchase_group"/>
        </record>

        <!-- ==================== Warehouse Custom Groups ==================== -->
        <record id="inventory_user_group" model="res.groups">
            <field name="name">Inventory User</field>
            <field name="category_id" ref="app_one.inventory_group"/>
        </record>

        <record id="inventory_admin_group" model="res.groups">
            <field name="name">Inventory Admin</field>
            <field name="category_id" ref="app_one.inventory_group"/>
        </record>

    </data>

