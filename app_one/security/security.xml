        <!-- ==================== Sales Groups ==================== -->
        <record id="group_sales_local_user" model="res.groups">
            <field name="name">Sales local</field>
            <field name="category_id" ref="sales_group"/>
        </record>
        <record id="group_sales_global_user" model="res.groups">
            <field name="name">Sales Global</field>
            <field name="category_id" ref="sales_group"/>
        </record>

