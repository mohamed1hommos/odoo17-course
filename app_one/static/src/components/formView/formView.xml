<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="app_one.FormView">
        <div class="p-3">
            <div class="mb-3">
                <label>Name</label>
                <input t-model="state.name" placeholder="Enter Property Name"/>
            </div>
            <div class="mb-3">
                <label>PostCode</label>
                <input t-model="state.postcode" placeholder="Enter Property PostCode"/>
            </div>
            <div class="mb-3">
                <label>Date Availability</label>
                <input t-model="state.date_availability"  type="date" placeholder="Enter PostCode Name"/>
            </div>
            <div class="footer">
                <button class="btn btn-primary me-2" t-om-click="this.createRecord" > SAVE </button>
                <button class="btn btn-secondary me-2" t-om-click="this.cancel" > Cancel </button>

            </div>

        </div>
    </t>
</templates>



