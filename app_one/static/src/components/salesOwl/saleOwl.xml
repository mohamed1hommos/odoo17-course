                            <tr class="tbody tr">
                                <td ><t t-esc="record.partner_id[1]"/></td>
<!--                                <td ><t t-esc="line.amount_total"/></td>-->
                                <td ><t t-esc="record.state"/></td>
        <!--                        <td ><t t-esc="record.living_rooms"/></td>-->
        <!--                        <td ><t t-esc="record.is_late"/></td>-->
                            </tr>
<!--                        </t>-->
                    </t>
