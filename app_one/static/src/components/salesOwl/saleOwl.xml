<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="app_one.SaleOwl">
        <div class="app_one.saleowl'" style="height: 1000px; overflow-y: auto;">>
            <table class="table">
                <thead class="thead">
                    <tr class="thead tr">
                        <th class="thead th">Customer</th>
<!--                        <th class="thead th">amount_total</th>-->
                        <th class="thead th">state</th>
<!--                        <th class="thead th">living_rooms</th>-->
<!--                        <th class="thead th">is_late</th>-->
                    </tr>
                </thead>
                <tbody class="tbody">
                    <t t-foreach="state.records" t-as="record" t-key="record.id">
