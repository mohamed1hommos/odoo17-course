<odoo>
    <!-- Action -->
    <record id="building_action" model="ir.actions.act_window">
        <field name="name">Building</field>
        <field name="res_model">building</field>
        <field name="view_mode">tree,form</field>  <!-- مهم جداً -->
    </record>
     Tree View
    <record id="building_view_tree" model="ir.ui.view">
        <field name="name">building.tree</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <tree>
                <field name="number"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="building_view_form" model="ir.ui.view">
        <field name="name">building.form</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
<!--                    <div class ="oe_title">-->
<!--                        <label for="name"/>-->
<!--                            <h1>-->
<!--                                <field name="name" />-->
<!--                            </h1>-->
<!--                    </div>-->
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="description"/>
                        </group>
                         <group >
                              <field name="code"/>
                             <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- القوائم -->

    <menuitem
        id="building_menu_item"
        name="building"
        parent="properties_menu"
        action="building_action"
        sequence="2"
    />

</odoo>

