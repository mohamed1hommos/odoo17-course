<odoo>
    <!-- Action -->
    <record id="owners_action" model="ir.actions.act_window">
        <field name="name">Owners</field>
        <field name="res_model">owner</field>
        <field name="view_mode">tree,form</field>  <!-- مهم جداً -->
    </record>

     Tree View
    <record id="owner_view_tree" model="ir.ui.view">
        <field name="name">owner.tree</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="phone"/>
                <field name="address"/>
                <field name="property_ids"/>
            </tree>
        </field>
    </record>

    <!-- Form View (أضفها عشان تكتمل) -->
    <record id="owner_view_form" model="ir.ui.view">
        <field name="name">owner.form</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class ="oe_title">
                        <label for="name"/>
                            <h1>
                                <field name="name" />
                            </h1>
                    </div>
                    <group>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="property_ids" widget="many2many_tags"/>
                    </group>
                        <group >
                        </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- القوائم -->

    <menuitem
        id="owner_menu_item"
        name="owners"
        parent="configurations_menu"
        action="owners_action"
        sequence="1"
    />

</odoo>

