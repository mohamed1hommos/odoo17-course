<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_view" model="ir.ui.view">
        <field name="name">purchase.order</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="free" string="Free"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="create_uid"/>
            </xpath>
            <!-- Read Only لما الـ state يكون purchase أو done أو cancel -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state in ['purchase', 'done', 'cancel']</attribute>
            </xpath>

            <!-- إخفاء Add a product / Add a section / Add a note -->
            <xpath expr="//field[@name='order_line']//control" position="attributes">
                <attribute name="invisible">state in ['purchase', 'done', 'cancel']</attribute>
            </xpath>

            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">state in ['purchase','done','cancel']</attribute>
            </xpath>


        </field>
    </record>
</odoo>