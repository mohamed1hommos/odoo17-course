<odoo>
    <!-- Action -->
    <record id="tags_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">tag</field>
        <field name="view_mode">tree,form</field>  <!-- مهم جداً -->
    </record>

     Tree View
    <record id="tag_view_tree" model="ir.ui.view">
        <field name="name">tag.tree</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Form View (أضفها عشان تكتمل) -->
    <record id="tag_view_form" model="ir.ui.view">
        <field name="name">tag.form</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class ="oe_title">
                        <label for="name"/>
                            <h1>
                                <field name="name" />
                            </h1>
                    </div>
                    <group>
                    </group>
                        <group >
                        </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- القوائم -->

    <menuitem
        id="tag_menu_item"
        name="tags"
        parent="configurations_menu"
        action="tags_action"
        sequence="2"
    />

</odoo>

