<odoo>
     <record id="change_state_wizard_action" model="ir.actions.act_window">
        <field name="name">change state </field>
        <field name="res_model">change_state</field>
         <field name="target">new</field>
         <field name="view_mode">form</field>
    </record>
    <record id="change_state_wizard_view_form" model="ir.ui.view">
        <field name="name">change state wizard form</field>
        <field name="model">change_state</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="property_id" invisible="1"/>
                    <field name="state"/>
                    <field name="reason" required="1"/>
                </group>
                <footer>
                    <button string="confirm" type="object" class="btn-primary" name="action_confirm"/>
                    <button string="cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>